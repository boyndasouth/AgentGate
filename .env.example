# Copy to .env (never commit .env).  PowerShell:  Copy-Item .env.example .env

# --- Local Docker Compose ---------------------------------------------------
OPENFGA_VERSION=latest          # pin a version (e.g. v1.x.y) once Day 1 passes
FGA_DB_USER=openfga
FGA_DB_PASSWORD=openfga
FGA_DB_NAME=openfga
BROKER_DB_USER=agentgate
BROKER_DB_PASSWORD=agentgate
BROKER_DB_NAME=agentgate

# --- OpenFGA (filled in by policy/load_store.py on Day 1) -------------------
OPENFGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=

# --- Broker (Day 2) -----------------------------------------------------------
# Ed25519 private key in PEM, or a path to it. Generate on Day 2; never commit.
AGENTGATE_SIGNING_KEY_PATH=./secrets/agentgate_ed25519.pem
AGENTGATE_TOKEN_TTL_SECONDS=600
DATABASE_URL=postgresql://agentgate:agentgate@localhost:5433/agentgate

# --- Demo agents (Day 3) ------------------------------------------------------
GEMINI_API_KEY=
LOGFIRE_TOKEN=

# --- Slack approvals (Day 4) --------------------------------------------------
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-            # Socket Mode for local dev
SLACK_APPROVALS_CHANNEL=#agentgate-approvals

# --- Supabase (Day 3 deploy, Day 6 Realtime) ----------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # broker only, never the UI

# --- Auth0 (Day 6 admin UI) ---------------------------------------------------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
