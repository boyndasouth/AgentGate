# AgentGate local broker settings. Copy to .env (never commit .env).
#   Copy-Item .env.example .env
# Then fill the secrets below:
#   docker compose run --rm broker python -m app.keys | Add-Content -Encoding ascii .env
# (Add-Content, not >>: Windows PowerShell 5.1's >> writes UTF-16, which docker compose can't read.)

# --- OpenFGA (pinned; must match the Render Dockerfile ARG) ---
OPENFGA_VERSION=v1.22.1
# Written by: py scripts/load_store.py --replace
FGA_STORE_ID=
FGA_MODEL_ID=

# --- Broker database (compose service address, NOT localhost:5433) ---
DATABASE_URL=postgresql://agentgate:agentgate@broker-postgres:5432/agentgate

# --- Secrets from `python -m app.keys` (one set for local, a different set for Render) ---
# AGENTGATE_SIGNING_KEY=
# AGENTGATE_ADMIN_KEY=
# AGENTGATE_ORCHESTRATOR_KEY=
# AGENTGATE_ARGS_HMAC_KEY=

# --- Optional ---
# TOKEN_TTL_SECONDS=600
# APPROVAL_TTL_SECONDS=120

# --- Slack (optional; without it, approvals go through the admin API / UI) ---
# Local dev uses the Socket Mode app ("AgentGate Dev"): set SLACK_APP_TOKEN.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=
# SLACK_APPROVALS_CHANNEL=C0...
# SLACK_APPROVERS=U0123ABCD=shiwin
