@@ -0,0 +1,62 @@
+# Deploying AgentGate to Render + Supabase (Day 3)
+
+One free Render web service runs the broker **and** OpenFGA (in-memory, bound to
+127.0.0.1). At every boot `seed_fga.py` creates the store from `policy/model.json` +
+`policy/tuples.yaml`, runs 6 policy sanity checks (boot fails if any is wrong), and
+exports `FGA_STORE_ID` / `FGA_MODEL_ID` to the broker. State that must survive restarts
+(sessions, tokens, revocations, approvals, audit chain) lives in Supabase Postgres.
+
+Why one container: two free services would mean two cold starts in a row and an
+OpenFGA endpoint on the public internet. Policy tuples are static seed data, so losing
+them on restart costs nothing; they are re-seeded in about a second.
+
+## 1. Supabase (database)
+
+1. New project. Pick the region closest to your Render region. Save the DB password.
+2. **Connect → Session pooler** (port **5432**, host `aws-…pooler.supabase.com`).
+   Not "Direct connection" (IPv6-only; Render can't reach it) and not
+   "Transaction pooler" (6543; breaks asyncpg prepared statements).
+3. Build the URL and append `?sslmode=require`:
+   `postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require`
+   URL-encode special characters in the password (`@` → `%40`, `#` → `%23`, `/` → `%2F`).
+
+## 2. Render (broker + OpenFGA)
+
+1. Commit and push (including `render.yaml`, `deploy/`, `policy/model.json`).
+2. Generate **new** production secrets (don't reuse local ones):
+   `docker compose run --rm broker python -m app.keys`
+3. Render → **New → Blueprint** → pick the repo. It reads `render.yaml`.
+   Fill the `sync: false` vars: `DATABASE_URL`, `AGENTGATE_SIGNING_KEY`,
+   `AGENTGATE_ADMIN_KEY`, `AGENTGATE_ORCHESTRATOR_KEY`, `AGENTGATE_ARGS_HMAC_KEY`.
+4. Deploy. In the logs you want, in order:
+   `[seed_fga] store=… tuples=12` → `[seed_fga] 6 sanity checks passed` → broker startup.
+5. Supabase → SQL Editor → run `deploy/supabase_rls.sql` (tables exist only after step 4).
+
+## 3. Point the agents at it
+
+Create `.env.render` (gitignored!) in the repo root, ascii-encoded:
+
+```powershell
+Set-Content -Encoding ascii .env.render @(
+  'AGENTGATE_URL=https://agentgate-broker.onrender.com',
+  'AGENTGATE_ORCHESTRATOR_KEY=<prod orchestrator key>',
+  'AGENTGATE_ADMIN_KEY=<prod admin key>'
+)
+Add-Content -Encoding ascii .gitignore '.env.render'
+.\scripts\check_deploy.ps1
+.\scripts\run_agents.ps1 -Target render pay
+```
+
+**Done check:** the `pay` run prints `transfer_funds allow audit_id=N`, the row shows in
+Supabase → Table Editor → `audit_events`, and `/audit/verify` says the chain is valid.
+
+## Troubleshooting
+
+| Symptom | Likely cause |
+| --- | --- |
+| Deploy hangs on "No open ports detected" | Broker not binding `0.0.0.0:$PORT`; set `BROKER_CMD` |
+| `seed_fga … policy check failed` | `policy/model.json` stale; run `scripts/export_model_json.ps1` |
+| `connection refused` / DNS error to `db.<ref>.supabase.co` | Used the direct connection; switch to session pooler |
+| `prepared statement … already exists` | Used port 6543; switch to 5432 |
+| `too many clients` / `max client connections reached` | Old + new instance during deploy each hold a full asyncpg pool; lower the broker's pool `max_size` to 5 |
+| First request takes ~1 min | Free instance waking up; `check_deploy.ps1` warms it before demos |
diff --git a/deploy/render/seed_fga.py b/deploy/render/seed_fga.py
new file mode 100644
index 0000000..8e92cfb
--- /dev/null
+++ b/deploy/render/seed_fga.py
@@ -0,0 +1,116 @@
+"""Seed an in-memory OpenFGA at container boot (Render deploy).
+
+OpenFGA runs inside the broker container with the memory datastore, so the
+store is empty on every boot. This script:
+  1. waits for OpenFGA to be healthy,
+  2. creates a store, writes policy/model.json and policy/tuples.yaml,
+  3. replays a few sanity checks (fails the boot if policy is wrong),
+  4. prints `export FGA_STORE_ID=... FGA_MODEL_ID=...` for start.sh to eval.
+
+Only stdout carries the export lines; all logging goes to stderr.
+Stdlib + PyYAML only, same REST approach as scripts/load_store.py.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+import time
+import urllib.error
+import urllib.request
+
+import yaml
+
+FGA = os.environ.get("FGA_LOCAL_URL", "http://127.0.0.1:8080")
+POLICY_DIR = os.environ.get("POLICY_DIR", "/srv/policy")
+
+
+def log(msg: str) -> None:
+    print(f"[seed_fga] {msg}", file=sys.stderr, flush=True)
+
+
+def call(method: str, path: str, body: dict | None = None) -> dict:
+    data = json.dumps(body).encode() if body is not None else None
+    req = urllib.request.Request(
+        FGA + path, data=data, method=method, headers={"Content-Type": "application/json"}
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=10) as resp:
+            return json.loads(resp.read() or b"{}")
+    except urllib.error.HTTPError as e:
+        raise SystemExit(f"[seed_fga] {method} {path} -> {e.code}: {e.read().decode()}")
+
+
+def wait_healthy(timeout_s: float = 30) -> None:
+    deadline = time.monotonic() + timeout_s
+    while time.monotonic() < deadline:
+        try:
+            with urllib.request.urlopen(FGA + "/healthz", timeout=2) as resp:
+                if json.loads(resp.read()).get("status") == "SERVING":
+                    return
+        except Exception:
+            pass
+        time.sleep(0.3)
+    raise SystemExit("[seed_fga] OpenFGA did not become healthy in time")
+
+
+def to_tuple_key(t: dict) -> dict:
+    key = {"user": t["user"], "relation": t["relation"], "object": t["object"]}
+    if "condition" in t:
+        cond = {"name": t["condition"]["name"]}
+        if t["condition"].get("context"):
+            cond["context"] = t["condition"]["context"]
+        key["condition"] = cond
+    return key
+
+
+def check(store: str, model: str, user: str, relation: str, obj: str, ctx: dict) -> bool:
+    body = {
+        "authorization_model_id": model,
+        "tuple_key": {"user": user, "relation": relation, "object": obj},
+        "context": ctx,
+    }
+    return call("POST", f"/stores/{store}/check", body)["allowed"]
+
+
+def main() -> None:
+    wait_healthy()
+
+    with open(os.path.join(POLICY_DIR, "model.json"), encoding="utf-8") as f:
+        model_json = json.load(f)
+    with open(os.path.join(POLICY_DIR, "tuples.yaml"), encoding="utf-8") as f:
+        tuples = yaml.safe_load(f)
+
+    store = call("POST", "/stores", {"name": "agentgate"})["id"]
+    model = call("POST", f"/stores/{store}/authorization-models", model_json)["authorization_model_id"]
+    # OpenFGA accepts up to 100 tuples per write; the demo has 12.
+    call("POST", f"/stores/{store}/write", {
+        "authorization_model_id": model,
+        "writes": {"tuple_keys": [to_tuple_key(t) for t in tuples]},
+    })
+    log(f"store={store} model={model} tuples={len(tuples)}")
+
+    clean = {"amount": 40.0, "session_tainted": False}
+    big = {"amount": 5000.0, "session_tainted": False}
+    tainted = {"amount": 0.0, "session_tainted": True}
+    expectations = [
+        ("agent:finance", "can_invoke", "tool:transfer_funds", clean, True),
+        ("agent:finance", "can_invoke", "tool:transfer_funds", big, False),
+        ("agent:finance", "can_request_approval", "tool:transfer_funds", big, True),
+        ("agent:mailer", "can_invoke", "tool:send_email", tainted, False),
+        ("agent:mailer", "can_request_approval", "tool:send_email", tainted, True),
+        ("agent:researcher", "can_request_approval", "tool:transfer_funds", clean, False),
+    ]
+    for user, rel, obj, ctx, want in expectations:
+        got = check(store, model, user, rel, obj, ctx)
+        if got != want:
+            raise SystemExit(f"[seed_fga] policy check failed: {user} {rel} {obj} {ctx} -> {got}, want {want}")
+    log(f"{len(expectations)} sanity checks passed")
+
+    print(f"export FGA_STORE_ID={store}")
+    print(f"export FGA_MODEL_ID={model}")
+
+
+if __name__ == "__main__":
+    main()
