model
  schema 1.1

# AgentGate authorization model.
# Decision engine (broker, Day 2):
#   can_invoke            -> allow
#   can_request_approval  -> escalate to a human in Slack
#   neither               -> deny
# Always send `amount`, `session_tainted`, `host`, `recipient_domain`, `payee` and `invoice_matches`
# in the check context of a tool check (`current_time` in a delegation check):
# OpenFGA errors when a conditional tuple's parameter is missing.

type user

type agent
  relations
    define owner: [user]

type tool
  relations
    # Act immediately, optionally only while a condition holds.
    define direct_invoker: [agent, agent with untainted, agent with within_limit_open_invoice, agent with untainted_or_allowed_host, agent with untainted_allowed_recipient]
    # Act only after a human approves.
    define approval_invoker: [agent]
    # Humans who may approve escalations for this tool.
    define approver: [user]

    define can_invoke: direct_invoker
    define can_request_approval: approval_invoker or direct_invoker

# Day 10: delegation chains. Agent A grants agent B some of its tools for a while (one tuple per
# relation below); B then trades its own token for one that acts on A's behalf. A delegated call
# is judged AS A (A's grants and conditions), and only while every hop is live:
#   check(agent:B,  delegate, delegation:d)   B still holds it, not expired (current_time)
#   check(tool:X,   covers,   delegation:d)   the grant includes this tool
# A hop-2 grant (B passes it on to C) points at hop 1 through `parent`; the broker checks every hop.
type delegation
  relations
    define delegator: [agent]
    define delegate: [agent with not_expired]
    define covers: [tool]
    define parent: [delegation]

# The session has not read untrusted content (web page, inbound email).
condition untainted(session_tainted: bool) {
  !session_tainted
}

# Small amount AND a clean session AND a payee on the tuple's allowlist AND an open invoice that
# matches. One tuple can carry only one condition, so all four checks live here:
#  - a tainted session never moves money alone;
#  - (Day 9, closes G04) neither does a clean one paying an account nobody has approved;
#  - (Day 10, closes G05) neither does one paying an approved vendor money it isn't owed.
# `payee` is the to_account argument exactly as sent (exact match, no normalising).
# `invoice_matches` is computed by the broker: the invoice_id names an OPEN invoice from that
# payee for exactly that amount (broker/app/invoices.py). Paying it marks it paid.
condition within_limit_open_invoice(amount: double, max_amount: double, session_tainted: bool, payee: string, allowed_payees: list<string>, invoice_matches: bool) {
  amount <= max_amount && !session_tainted && payee in allowed_payees && invoice_matches
}

# Day 7 (closes G03): reading a URL also sends data out, in the URL itself. Once the session
# is tainted, only hosts on the tuple's allowlist may be read (exact match, no wildcards).
# `host` is the URL's hostname, parsed by the broker; '' for tools without a URL.
condition untainted_or_allowed_host(session_tainted: bool, host: string, allowed_hosts: list<string>) {
  !session_tainted || host in allowed_hosts
}

# Day 8 (closes G01): taint only catches injections the gate saw arrive. An instruction stored
# in internal data (a CRM note) or carried into a new run reaches the mailer in a clean session.
# So sending alone also needs a recipient on the tuple's allowlist (exact domain match, no
# wildcards); mail to anyone else goes to a human, whatever the session looks like.
# `recipient_domain` is the domain of the single recipient, parsed by the broker; '' for tools
# without a recipient or when the address isn't one plain address.
condition untainted_allowed_recipient(session_tainted: bool, recipient_domain: string, allowed_recipient_domains: list<string>) {
  !session_tainted && recipient_domain in allowed_recipient_domains
}

# Day 10: a delegation is live until its expiry; the broker sends the current time with each check.
condition not_expired(current_time: timestamp, expires_at: timestamp) {
  current_time < expires_at
}
