# AgentGate admin UI. Copy to .env for local dev; set the same names in Vercel.
# Everything without PUBLIC_ stays on the server and never reaches the browser.

# --- Auth.js + Auth0 (Regular Web Application) ---
# AUTH_SECRET: 32 random bytes, base64 (command in ui/README.md)
AUTH_SECRET=
AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=
AUTH_AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
AUTH_TRUST_HOST=true

# --- Who may use the UI ---
# Auth0 subs and/or verified emails, comma-separated. Quote values that contain |
ADMIN_USERS="you@example.com"
# "<sub or email>=<OpenFGA user>", comma-separated. Only mapped admins can Approve/Deny.
APPROVERS="you@example.com=shiwin"

# --- Broker (server-side only) ---
# Local broker: http://localhost:8000
BROKER_URL=https://agentgate-broker.onrender.com
AGENTGATE_ADMIN_KEY=
# Optional: enables the Demo runner (scripted agents). Leave empty to hide it.
AGENTGATE_ORCHESTRATOR_KEY=

# --- Live feed (optional; without these the feed polls every 3 s) ---
# The anon/publishable key is safe in the browser: RLS does the gating.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Public "Be the approver" sandbox on /tour (no login). Off unless this is 1. Needs the sandbox agents seeded
# on the broker first: py eval/seed_sandbox.py --target render. Uses the orchestrator + admin keys above.
AGENTGATE_SANDBOX=0
